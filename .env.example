# ===========================================
# Empire Lounge - Environment Variables
# ===========================================

# Site URL
NEXT_PUBLIC_SITE_URL=https://empire-lounge.com

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SECRET_KEY=your-secret-key

# Business Configuration
BUSINESS_TIMEZONE=Africa/Douala

# Email Configuration (Resend)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Empire Lounge <noreply@empire-lounge.com>
CONTACT_EMAIL=info@empire-lounge.com
SEND_CONTACT_CONFIRMATION=true

# Payment Provider (campay, monetbil, sandbox)
PAYMENT_PROVIDER=sandbox

# CamPay Configuration (when PAYMENT_PROVIDER=campay)
PAYMENT_API_BASE_URL=https://api.campay.net
PAYMENT_API_KEY=your-campay-api-key
PAYMENT_API_USERNAME=your-campay-username
PAYMENT_API_PASSWORD=your-campay-password
PAYMENT_WEBHOOK_SECRET=your-webhook-secret

# Monetbil Configuration (when PAYMENT_PROVIDER=monetbil)
MONETBIL_API_KEY=your-monetbil-api-key
MONETBIL_WEBHOOK_SECRET=your-monetbil-webhook-secret

# QR Code Security
QR_TOKEN_PEPPER=your-random-pepper-string
QR_SIGNING_SECRET=your-signing-secret

# Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:info@empire-lounge.com

# Cron Security
CRON_SECRET=your-cron-secret-key

# Error Monitoring (optional - Sentry, etc.)
ERROR_MONITORING_DSN=
